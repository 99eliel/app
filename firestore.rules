rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Controle do produto: superadministradores são provisionados manualmente
    // no console. É intencional não permitir que usuários elevem a própria função.
    function loggedIn() {
      return request.auth != null;
    }
    function platformAdmin() {
      return loggedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.enabled == true;
    }
    function isMember(cityId) {
      return loggedIn()
        && exists(/databases/$(database)/documents/municipalities/$(cityId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/municipalities/$(cityId)/members/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/municipalities/$(cityId)/members/$(request.auth.uid)).data.role in ['admin','editor'];
    }
    function canView(cityId) {
      return platformAdmin() || isMember(cityId);
    }
    // A suspensão comercial não apaga registros nem retira acesso de leitura
    // da equipe autorizada. Apenas gravações municipais são interrompidas.
    function currentLicense(cityId) {
      return exists(/databases/$(database)/documents/licenses/$(cityId))
        && get(/databases/$(database)/documents/licenses/$(cityId)).data.status in ['trial','active','grace']
        && get(/databases/$(database)/documents/licenses/$(cityId)).data.validUntil is timestamp
        && get(/databases/$(database)/documents/licenses/$(cityId)).data.validUntil > request.time;
    }
    function canEdit(cityId) {
      return platformAdmin() || (isMember(cityId) && currentLicense(cityId));
    }
    function cityActive(cityId) {
      return get(/databases/$(database)/documents/municipalities/$(cityId)).data.active == true;
    }
    function validCity(data) {
      return data.keys().hasOnly(['name','state','active','createdAt','updatedAt'])
        && data.keys().hasAll(['name','state','active','createdAt','updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 85
        && data.state is string && data.state.matches('^[A-Z]{2}$')
        && data.active is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validUnit(data) {
      return data.keys().hasOnly(['name','type','district','address','hours','phone','published','createdAt','updatedAt'])
        && data.keys().hasAll(['name','type','district','address','hours','phone','published','createdAt','updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 90
        && data.type in ['UBS','UPA','Farmácia','Laboratório','Outro']
        && data.district is string && data.district.size() <= 80
        && data.address is string && data.address.size() <= 180
        && data.hours is string && data.hours.size() <= 120
        && data.phone is string && data.phone.size() <= 50
        && data.published is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validNotice(data) {
      return data.keys().hasOnly(['title','kind','description','published','createdAt','updatedAt'])
        && data.keys().hasAll(['title','kind','description','published','createdAt','updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.kind in ['Comunicado','Campanha','Serviço','Evento']
        && data.description is string && data.description.size() > 0 && data.description.size() <= 800
        && data.published is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validEvent(data) {
      return data.keys().hasOnly(['title','date','time','place','description','published','createdAt','updatedAt'])
        && data.keys().hasAll(['title','date','time','place','description','published','createdAt','updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 90
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string && data.time.size() <= 5
        && data.place is string && data.place.size() <= 120
        && data.description is string && data.description.size() <= 400
        && data.published is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }


    function validLicense(data) {
      return data.keys().hasOnly(['status','planCode','validUntil','monthlyPriceCents','notes','createdAt','updatedAt'])
        && data.keys().hasAll(['status','planCode','validUntil','monthlyPriceCents','notes','createdAt','updatedAt'])
        && data.status in ['trial','active','grace','suspended','canceled']
        && data.planCode in ['Inicial','Essencial','Profissional','Municipal','Personalizado']
        && data.validUntil is timestamp
        && data.monthlyPriceCents is int && data.monthlyPriceCents >= 0
        && data.monthlyPriceCents <= 100000000
        && data.notes is string && data.notes.size() <= 500
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validLicenseLog(data) {
      return data.keys().hasOnly(['action','actorUid','previousStatus','nextStatus','changedAt'])
        && data.keys().hasAll(['action','actorUid','previousStatus','nextStatus','changedAt'])
        && data.action in ['save','suspend']
        && data.actorUid == request.auth.uid
        && data.previousStatus in ['trial','active','grace','suspended','canceled','unconfigured']
        && data.nextStatus in ['trial','active','grace','suspended','canceled']
        && data.changedAt is timestamp;
    }

    // Metadados comerciais são privados e NUNCA ficam em municípios públicos.
    match /licenses/{cityId} {
      allow get, list: if platformAdmin();
      allow create: if platformAdmin()
        && exists(/databases/$(database)/documents/municipalities/$(cityId))
        && validLicense(request.resource.data);
      allow update: if platformAdmin()
        && validLicense(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /history/{eventId} {
        allow get, list: if platformAdmin();
        allow create: if platformAdmin() && validLicenseLog(request.resource.data);
        allow update, delete: if false;
      }
    }

    // Catálogo estrutural inspirado no ConecteBR, sem importar dados da cidade.
    function moduleIdValid(moduleId) {
      return moduleId in ['upa','esf','agendamentos','triagem','laboratorio','farmacia',
       'escalas','campanhas','cetec','servicos','engenharia','meioambiente',
       'educacao','esportes','infraestrutura'];
    }
    function moduleEnabled(cityId,moduleId) {
      return exists(/databases/$(database)/documents/municipalities/$(cityId)/moduleSettings/$(moduleId))
        && get(/databases/$(database)/documents/municipalities/$(cityId)/moduleSettings/$(moduleId)).data.enabled == true;
    }
    function moduleSettingsValid(data) {
      return data.keys().hasOnly(['enabled','updatedAt'])
        && data.keys().hasAll(['enabled','updatedAt'])
        && data.enabled is bool
        && data.updatedAt is timestamp;
    }
    function entryValid(data,moduleId) {
      return data.keys().hasOnly(['moduleKey','title','description','details','address',
          'phone','hours','link','published','createdAt','updatedAt'])
        && data.keys().hasAll(['moduleKey','title','description','details','address',
          'phone','hours','link','published','createdAt','updatedAt'])
        && data.moduleKey == moduleId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 600
        && data.details is string && data.details.size() <= 1000
        && data.address is string && data.address.size() <= 180
        && data.phone is string && data.phone.size() <= 50
        && data.hours is string && data.hours.size() <= 160
        && data.link is string && data.link.size() <= 300
        && (data.link == '' || data.link.matches('^https://[^ ]+
      allow get: if loggedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /municipalities/{cityId} {
      allow get, list: if platformAdmin() || resource.data.active == true;
      allow create: if platformAdmin() && validCity(request.resource.data);
      allow update: if platformAdmin() && validCity(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /members/{userId} {
        allow get: if platformAdmin() || (loggedIn() && request.auth.uid == userId);
        allow list: if platformAdmin();
        allow create, update: if platformAdmin()
          && request.resource.data.keys().hasOnly(['role','enabled','updatedAt'])
          && request.resource.data.keys().hasAll(['role','enabled','updatedAt'])
          && request.resource.data.role in ['admin','editor']
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is timestamp;
        allow delete: if platformAdmin();
      }

      match /moduleSettings/{moduleId} {
        allow get, list: if canView(cityId)
          || (cityActive(cityId) && resource.data.enabled == true);
        allow create, update: if canEdit(cityId) && moduleIdValid(moduleId)
          && moduleSettingsValid(request.resource.data);
        allow delete: if false;
      }
      match /moduleEntries/{moduleId}/items/{entryId} {
        allow get, list: if canView(cityId)
          || (cityActive(cityId) && moduleEnabled(cityId,moduleId)
            && resource.data.published == true);
        allow create: if canEdit(cityId) && moduleIdValid(moduleId)
          && entryValid(request.resource.data,moduleId);
        allow update: if canEdit(cityId) && moduleIdValid(moduleId)
          && entryValid(request.resource.data,moduleId)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
      match /moduleStatus/{moduleId} {
        allow get: if canView(cityId)
          || (moduleId == 'upa' && cityActive(cityId)
            && moduleEnabled(cityId,'upa') && resource.data.published == true);
        allow list: if false;
        allow create, update: if moduleId == 'upa' && canEdit(cityId)
          && validUpaStatus(request.resource.data);
        allow delete: if false;
      }
      match /appointmentRequests/{requestId} {
        allow get, list: if canView(cityId)
          || (loggedIn() && resource.data.ownerUid == request.auth.uid);
        allow create: if citizenCreateRequest(cityId,'agendamentos',request.resource.data);
        allow update: if citizenCancel(resource.data,request.resource.data)
          || teamChangeRequest(cityId,resource.data,request.resource.data);
        allow delete: if false;
      }
      match /courseRegistrations/{requestId} {
        allow get, list: if canView(cityId)
          || (loggedIn() && resource.data.ownerUid == request.auth.uid);
        allow create: if citizenCreateRequest(cityId,'cetec',request.resource.data);
        allow update: if citizenCancel(resource.data,request.resource.data)
          || teamChangeRequest(cityId,resource.data,request.resource.data);
        allow delete: if false;
      }
      match /units/{recordId} {
        allow get, list: if canView(cityId) || (cityActive(cityId) && resource.data.published == true);
        allow create: if canEdit(cityId) && validUnit(request.resource.data);
        allow update: if canEdit(cityId) && validUnit(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
      match /notices/{recordId} {
        allow get, list: if canView(cityId) || (cityActive(cityId) && resource.data.published == true);
        allow create: if canEdit(cityId) && validNotice(request.resource.data);
        allow update: if canEdit(cityId) && validNotice(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
      match /events/{recordId} {
        allow get, list: if canView(cityId) || (cityActive(cityId) && resource.data.published == true);
        allow create: if canEdit(cityId) && validEvent(request.resource.data);
        allow update: if canEdit(cityId) && validEvent(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
))
        && data.published is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validUpaStatus(data) {
      return data.keys().hasOnly(['queue','roomStatus','clinician','pediatrician','week','published','updatedAt'])
        && data.keys().hasAll(['queue','roomStatus','clinician','pediatrician','week','published','updatedAt'])
        && (data.queue == null || (data.queue is int && data.queue >= 0 && data.queue <= 9999))
        && data.roomStatus in ['unknown','available','occupied']
        && data.clinician is string && data.clinician.size() <= 100
        && data.pediatrician is string && data.pediatrician.size() <= 100
        && data.week is map
        && data.week.keys().hasAll(['segunda','terca','quarta','quinta','sexta','sabado','domingo'])
        && data.week.keys().hasOnly(['segunda','terca','quarta','quinta','sexta','sabado','domingo'])
        && data.week.get('segunda','') is string && data.week.get('segunda','').size() <= 160
        && data.week.get('terca','') is string && data.week.get('terca','').size() <= 160
        && data.week.get('quarta','') is string && data.week.get('quarta','').size() <= 160
        && data.week.get('quinta','') is string && data.week.get('quinta','').size() <= 160
        && data.week.get('sexta','') is string && data.week.get('sexta','').size() <= 160
        && data.week.get('sabado','') is string && data.week.get('sabado','').size() <= 160
        && data.week.get('domingo','') is string && data.week.get('domingo','').size() <= 160
        && data.published is bool && data.updatedAt is timestamp;
    }
    function validPublicRequest(data) {
      return data.keys().hasOnly(['ownerUid','targetId','status','createdAt','updatedAt'])
        && data.keys().hasAll(['ownerUid','targetId','status','createdAt','updatedAt'])
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.targetId is string && data.targetId.size() > 0 && data.targetId.size() <= 128
        && data.status in ['pending','confirmed','completed','canceled']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function citizenCreateRequest(cityId,section,data) {
      return loggedIn() && cityActive(cityId) && moduleEnabled(cityId,section)
        && currentLicense(cityId) && validPublicRequest(data)
        && data.ownerUid == request.auth.uid && data.status == 'pending'
        && exists(/databases/$(database)/documents/municipalities/$(cityId)/moduleEntries/$(section)/items/$(data.targetId))
        && get(/databases/$(database)/documents/municipalities/$(cityId)/moduleEntries/$(section)/items/$(data.targetId)).data.published == true;
    }
    function changeRequestStatus(data,old) {
      return validPublicRequest(data)
        && data.ownerUid == old.ownerUid
        && data.targetId == old.targetId
        && data.createdAt == old.createdAt
        && data.diff(old).affectedKeys().hasOnly(['status','updatedAt']);
    }
    function citizenCancel(old,data) {
      return loggedIn() && request.auth.uid == old.ownerUid
        && old.status == 'pending' && data.status == 'canceled'
        && changeRequestStatus(data,old);
    }
    function teamChangeRequest(cityId,old,data) {
      return canEdit(cityId) && changeRequestStatus(data,old);
    }
    match /platformAdmins/{userId} {
      allow get: if loggedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /municipalities/{cityId} {
      allow get, list: if platformAdmin() || resource.data.active == true;
      allow create: if platformAdmin() && validCity(request.resource.data);
      allow update: if platformAdmin() && validCity(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /members/{userId} {
        allow get: if platformAdmin() || (loggedIn() && request.auth.uid == userId);
        allow list: if platformAdmin();
        allow create, update: if platformAdmin()
          && request.resource.data.keys().hasOnly(['role','enabled','updatedAt'])
          && request.resource.data.keys().hasAll(['role','enabled','updatedAt'])
          && request.resource.data.role in ['admin','editor']
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is timestamp;
        allow delete: if platformAdmin();
      }

      match /units/{recordId} {
        allow get, list: if canView(cityId) || (cityActive(cityId) && resource.data.published == true);
        allow create: if canEdit(cityId) && validUnit(request.resource.data);
        allow update: if canEdit(cityId) && validUnit(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
      match /notices/{recordId} {
        allow get, list: if canView(cityId) || (cityActive(cityId) && resource.data.published == true);
        allow create: if canEdit(cityId) && validNotice(request.resource.data);
        allow update: if canEdit(cityId) && validNotice(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
      match /events/{recordId} {
        allow get, list: if canView(cityId) || (cityActive(cityId) && resource.data.published == true);
        allow create: if canEdit(cityId) && validEvent(request.resource.data);
        allow update: if canEdit(cityId) && validEvent(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
